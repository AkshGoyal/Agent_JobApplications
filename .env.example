# Copy to .env (or export these in your shell) and fill in real values.
# Never commit the real .env file — it's already in .gitignore.

# --- Required ---------------------------------------------------------------
# Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# --- Optional: model overrides ----------------------------------------------
JOBSEARCH_MODEL=
JOBSEARCH_MODEL_EXTRACT=
JOBSEARCH_MODEL_RANK=
JOBSEARCH_MODEL_TAILOR=
JOBSEARCH_MODEL_ANSWER=
JOBSEARCH_MODEL_OPPORTUNITIES=
JOBSEARCH_MAX_TOKENS_TAILOR=
JOBSEARCH_MAX_TOKENS_OPPORTUNITIES=

# --- Optional: paths ---------------------------------------------------------
JOBSEARCH_DB=

# --- Optional: Gmail alert ingestion (read-only IMAP) ------------------------
# Requires a Google "app password": myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
JOBSEARCH_ALERT_SENDER=
